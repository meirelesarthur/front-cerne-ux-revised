# =============================================================================
# GB Cerne — Frontend (exemplo de variáveis de ambiente)
# Copie para `.env` e ajuste os valores: cp .env.example .env
# =============================================================================

# --- API (backend Laravel GB.Cerne) ---------------------------------------
# baseURL da API nova, INCLUINDO o prefixo /api/v1. O código chama caminhos
# relativos (/auth/login, /auth/me). O endpoint de CSRF (/sanctum/csrf-cookie)
# está na RAIZ do backend e é derivado automaticamente desta URL.
VITE_API_PHP_BACK_URL=http://localhost:8080/api/v1

# Backend de chat/IA ("Aleex") — opcional; deixe vazio se não usado.
VITE_API_ALEEX_BACK_URL=

# Timeout das requisições em milissegundos.
VITE_API_TIMEOUT=30000

# --- Aplicação -------------------------------------------------------------
VITE_APP_NAME=GB Cerne
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# --- Flags -----------------------------------------------------------------
# false = API real. true = mocks locais.
VITE_USE_MOCK_API=false

# Modo de autenticação:
#   cookie = Sanctum SPA (sessão + CSRF). Front e backend no MESMO domínio (dev).
#   token  = Bearer token (localStorage + Authorization). Cross-domain (produção).
# Ausente => cookie (default seguro). Em produção cross-domain, defina como `token`.
VITE_AUTH_MODE=cookie

# --- Planos (PlanRole) — link de cadastro ----------------------------------
# GAP-FE-234: sem destino público definido no stack novo ainda (o legado
# apontava para agro365.app/admin/signup?plano_id={id}, domínio que não
# existe mais e um identificador que a API nova não expõe). Default: vazio —
# a tela de Visualização de Plano (TASK-FE-2703) monta a URL como
# `{VITE_SIGNUP_BASE_URL}?plano_id={uuid}` e degrada para link
# relativo/placeholder sem quebrar enquanto esta variável estiver vazia.
VITE_SIGNUP_BASE_URL=

# --- Site (link "Ver Site") -------------------------------------------------
# G-FE-01 (97-Esteiras/061, TASK-SITE-06): a página pública `website/{slug}`
# continua no MONÓLITO legado (strangler fig) — sem constante de URL prévia
# no repo. Default: vazio — `pages/Site/index.tsx` monta a URL como
# `{VITE_LEGACY_PUBLIC_BASE_URL}{slug}` e só renderiza o link "Ver Site"
# quando `published && slug` e esta variável estiverem todos presentes;
# degrada (não renderiza) enquanto estiver vazia, mesma disciplina de
# VITE_SIGNUP_BASE_URL acima.
VITE_LEGACY_PUBLIC_BASE_URL=

# --- DEV ONLY: bypass de login para trabalho de UX sem backend --------------
# true = login/me/logout respondem localmente (usuario ficticio, todas as
# permissoes). So funciona em `yarn dev` (import.meta.env.DEV); ignorado no
# build. NUNCA habilitar em homologacao/producao. Ver docs/ux/README.md.
VITE_DEV_AUTH_BYPASS=false

# --- DEV ONLY: dados simulados (axios adapter) para telas de lista/form ------
# true = rotas registradas em src/mocks/dev-api respondem localmente. So em
# `yarn dev`; ignorado no build. NUNCA habilitar em homologacao/producao.
VITE_DEV_MOCKS=false

# DEV ONLY: com VITE_DEV_MOCKS=true, rotas sem handler devolvem lista vazia/sucesso.
# false = deixa rotas sem handler irem a rede real.
VITE_DEV_MOCKS_FALLBACK=true
