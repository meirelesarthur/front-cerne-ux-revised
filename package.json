{
  "name": "gb-cerne-front",
  "private": true,
  "version": "1.0.0",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "description": "GB Cerne — Plataforma de Gestão Agro",
  "scripts": {
    "dev": "vite --host",
    "prepare": "npx @chakra-ui/cli typegen src/theme.ts",
    "validate:permissions": "node scripts/validate-permissions.mjs",
    "build": "npm run validate:permissions && node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc && node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
    "start": "serve -s dist -l 8080",
    "preview": "vite preview --host",
    "test:unit": "vitest run",
    "test:e2e:auth": "bash scripts/e2e/run-authenticated.sh",
    "lint": "eslint src --ext .ts,.tsx",
    "env:dev": "sh ./scripts/environment/variables.sh gb-cerne-front-end-develop",
    "env:hom": "sh ./scripts/environment/variables.sh gb-cerne-front-end-homolog",
    "env:prod": "sh ./scripts/environment/variables.sh gb-cerne-front-end-production"
  },
